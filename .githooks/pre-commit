#!/bin/sh

set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "Versionsprüfung: fehlgeschlagen — python3 fehlt." >&2
    exit 1
fi

if ! command -v swift >/dev/null 2>&1; then
    printf '%s\n' "Swift-Prüfung: fehlgeschlagen — swift fehlt." >&2
    exit 1
fi

# Build and tests must see the same files as the proposed commit.
if ! git diff --quiet --; then
    printf '%s\n' \
        "Commit abgebrochen: Es gibt ungestagte Änderungen." \
        "Bitte die gewünschten Änderungen stagen oder separat sichern." >&2
    exit 1
fi

untracked_files=$(git ls-files --others --exclude-standard)

if [ -n "$untracked_files" ]; then
    printf '%s\n' \
        "Commit abgebrochen: Es gibt nicht ignorierte, ungetrackte Dateien." \
        "Bitte diese stagen, ignorieren oder außerhalb des Repositorys sichern." >&2
    exit 1
fi

log_file=$(mktemp "${TMPDIR:-/tmp}/swit-pre-commit.XXXXXX")

trap 'rm -f "$log_file"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if ! python3 .githooks/check-version.py >"$log_file" 2>&1; then
    printf '%s\n' "Versionsprüfung: fehlgeschlagen" >&2
    cat "$log_file" >&2
    exit 1
fi

# Do not pass the parent repository's Git environment to test repositories.
git_local_variables=$(git rev-parse --local-env-vars)

for variable in $git_local_variables; do
    unset "$variable"
done

run_check() {
    label=$1
    shift

    if "$@" >"$log_file" 2>&1; then
        printf '%s: erfolgreich\n' "$label" >&2
    else
        printf '%s: fehlgeschlagen\n' "$label" >&2
        printf '%s\n' '--- Letzte 60 Logzeilen ---' >&2
        tail -n 60 "$log_file" >&2
        exit 1
    fi
}

run_check "swift build" swift build
run_check "swift test" swift test